# --- Required ---
GEMINI_API_KEY=                      # Your Google AI Studio API key
GEMINI_MODEL=                        # e.g. gemini-2.0-flash
GEMINI_FAST_MODEL=                   # (Optional) Smaller model for routing, defaults to GEMINI_MODEL
GEMINI_FALLBACK_MODELS=gemini-2.5-flash # Optional, comma-separated fallback models
GEMINI_EMBED_MODEL=                  # e.g. text-embedding-004
DATABASE_URL=                        # Neon direct URL, must include ?sslmode=require
ALLOWED_ORIGINS=                     # Comma-separated origins, e.g. http://localhost:3000,https://myapp.com

# --- Chroma: Cloud (if CHROMA_API_KEY is set) or Local ---
CHROMA_API_KEY=                      # Set for Chroma Cloud; omit for local PersistentClient
CHROMA_TENANT=                       # Required if CHROMA_API_KEY is set
CHROMA_DATABASE=                     # Required if CHROMA_API_KEY is set
CHROMA_PATH=chroma_data              # Local folder path; ignored when CHROMA_API_KEY is set
CHROMA_COLLECTION=documents          # Chroma collection name

# --- Tunables with safe defaults ---
MAX_UPLOAD_MB=10                     # Maximum PDF upload size in megabytes
MAX_PDF_PAGES=50                     # Reject PDFs exceeding this page count
MAX_DOCS_PER_SESSION=5               # Maximum documents a session may hold at once
MAX_QUESTION_CHARS=1000              # Maximum length of a chat question
CHUNK_SIZE=1000                      # Characters per chunk
CHUNK_OVERLAP=150                    # Character overlap between adjacent chunks
TOP_K=5                              # Chunks retrieved per /chat request
MAX_DISTANCE=1.4                     # Cosine distance cutoff; tune with evals/run_eval.py
MAX_SUMMARY_CHUNKS=20                # Chunks sampled for summarize mode
MAX_OUTPUT_TOKENS=1024               # Token cap on every model generation
DOCUMENT_TTL_HOURS=24                # Hours before documents and messages are purged
RATE_LIMIT_UPLOAD=5/hour             # slowapi limit for POST /documents
RATE_LIMIT_CHAT=10/minute            # slowapi limit for POST /chat
ENABLE_DOCS=false                    # Set to true to expose /docs and /openapi.json
